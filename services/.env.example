# ===== Kết nối SQL Server (chung cho mọi service) =====
DB_SERVER=localhost
DB_UID=sa
DB_PWD=YourStrong!Passw0rd
# Nếu dùng Windows Authentication thì để DB_UID rỗng: DB_UID=
DB_DRIVER=ODBC Driver 18 for SQL Server

# ===== JWT + bảo mật =====
JWT_SECRET=ibanking-demo-secret-change-me
JWT_EXPIRES_MINUTES=30

# ===== Token gọi nội bộ giữa các service =====
INTERNAL_TOKEN=internal-shared-secret

# ===== Gmail SMTP (notification-service :8006) =====
# Tạo App Password: https://myaccount.google.com/apppasswords (xem docs/12)
# Để trống GMAIL_USER → service chạy chế độ DRY RUN (ghi outbox, không gửi mail thật)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=iBanking - TDTU
# Đặt 1 để ép dry run kể cả khi đã điền Gmail
# NOTIFICATION_DRY_RUN=0